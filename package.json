{
  "name": "softjl-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SoftJL personal Windows modeling desktop",
  "author": "SoftJL contributors",
  "license": "Apache-2.0",
  "main": "dist/main/index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "build": "node scripts/build.mjs && node scripts/prepare-pdf-fonts.mjs",
    "package": "npm run build && node scripts/prepare-runtime.mjs && electron-builder --config electron-builder.json --win nsis --x64",
    "typecheck": "npm run typecheck:main && npm run typecheck:renderer",
    "typecheck:main": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:renderer": "tsc -b tsconfig.contracts.json && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run test:desktop && npm run test:modeling && npm run test:renderer",
    "test:desktop": "tsx --test \"src/main/backend/**/*.test.ts\" \"src/main/*.test.ts\"",
    "test:modeling": "tsx --test \"src/main/modeling/**/*.test.ts\" \"tests/modeling/**/*.test.ts\"",
    "test:contracts": "tsx --test \"src/shared/contracts/**/*.test.ts\"",
    "test:rendering": "tsx --test \"src/main/rendering/**/*.test.ts\"",
    "test:prompts": "tsx --test \"src/main/prompts/**/*.test.ts\"",
    "test:renderer": "vitest run --config vitest.config.ts",
    "smoke": "node scripts/smoke.mjs",
    "audit:docs": "node scripts/audit/documentation.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cors": "10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^8.3.0",
    "bullmq": "^5.79.0",
    "docx": "^9.6.1",
    "fastify": "5.12.7",
    "ioredis": "^5.11.1",
    "ip2region": "^2.3.0",
    "js-tiktoken": "^1.0.21",
    "openai": "^6.44.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.21.0",
    "saxes": "^6.0.0",
    "svg-to-pdfkit": "^0.1.8",
    "typebox": "1.3.37",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.15.29",
    "@assistant-ui/react-markdown": "^0.14.23",
    "@assistant-ui/store": "^0.3.21",
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@tailwindcss/vite": "^4.1.12",
    "@tanstack/react-table": "^8.21.3",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/matter-js": "^0.20.2",
    "@types/node": "22.15.21",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/svg-to-pdfkit": "^0.1.4",
    "@vitejs/plugin-react": "4.7.0",
    "@xyflow/react": "^12.12.0",
    "beautiful-mermaid": "^1.1.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "docx-preview": "0.4.1",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "i18next": "^26.3.6",
    "jsdom": "26.1.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.31.0",
    "matter-js": "^0.20.0",
    "motion": "^12.40.0",
    "next-themes": "0.4.6",
    "onborda": "^1.2.5",
    "playwright": "1.60.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "^17.0.9",
    "react-shiki": "^0.11.2",
    "recharts": "^3.8.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.1.12",
    "tsx": "4.19.4",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.14",
    "typescript": "5.8.3",
    "vaul": "^1.1.2",
    "vite": "6.4.4",
    "vitest": "4.1.11",
    "zustand": "^5.0.15"
  }
}
