{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src/shared/contracts",
    "outDir": ".cache/types/contracts",
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "tsBuildInfoFile": ".cache/types/contracts.tsbuildinfo"
  },
  "include": [
    "src/shared/contracts/**/*.ts"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
